<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<window id="1111">
  <defaultcontrol always="true">1210</defaultcontrol>
  <backgroundcolor>FF03070C</backgroundcolor>
  <onload>RunScript(skin.dejavu.poc,load_details)</onload>
  <controls>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>colors/black.png</texture>
      <colordiffuse>FF03070C</colordiffuse>
    </control>
    <control type="image">
      <left>0</left><top>64</top><width>1920</width><height>496</height>
      <texture>$INFO[Window(Home).Property(dv.details.fanart)]</texture>
      <aspectratio>scale</aspectratio>
    </control>
    <control type="image">
      <left>0</left><top>64</top><width>1920</width><height>496</height>
      <texture>hero_gradient_v08.png</texture>
      <aspectratio>stretch</aspectratio>
    </control>

    <include content="DejaVuHeader">
      <param name="ondown" value="1210" />
    </include>

    <control type="image">
      <left>72</left><top>80</top><width>90</width><height>28</height>
      <texture>dv_chip.png</texture>
    </control>
    <control type="label">
      <left>72</left><top>80</top><width>90</width><height>28</height>
      <label>FILM</label><font>font_flag</font><textcolor>FFFFFFFF</textcolor>
      <align>center</align><aligny>center</aligny>
    </control>
    <control type="label">
      <left>72</left><top>112</top><width>1180</width><height>56</height>
      <label>$INFO[Window(Home).Property(dv.details.title)]</label>
      <font>font45_title</font><textcolor>FFFFFFFF</textcolor><scroll>true</scroll>
    </control>
    <control type="label">
      <left>72</left><top>168</top><width>1180</width><height>28</height>
      <label>$INFO[Window(Home).Property(dv.details.tagline)]</label>
      <font>font13</font><textcolor>FFE3E7EC</textcolor>
      <scroll>true</scroll>
      <visible>!String.IsEmpty(Window(Home).Property(dv.details.tagline))</visible>
    </control>
    <control type="label">
      <left>72</left><top>204</top><width>1180</width><height>24</height>
      <label>$INFO[Window(Home).Property(dv.details.year)]$INFO[Window(Home).Property(dv.details.genre),  ·  ]</label>
      <font>font13</font><textcolor>FFE3E7EC</textcolor>
    </control>

    <control type="grouplist">
      <left>72</left><top>244</top><width>1180</width><height>40</height>
      <orientation>horizontal</orientation>
      <itemgap>14</itemgap>
      <control type="group">
        <width>210</width><height>36</height>
        <control type="label">
          <width>180</width><height>36</height>
          <label>dejaVu$INFO[Window(Home).Property(dv.details.rating_dejavu), ★ ]</label>
          <font>font13</font><textcolor>FFFFD54F</textcolor>
         <aligny>center</aligny>
        </control>
      </control>
      <control type="group">
        <width>200</width><height>36</height>
        <visible>!String.IsEmpty(Window(Home).Property(dv.details.rating_tmdb))</visible>
        <control type="label">
          <width>200</width><height>36</height>
          <label>TMDb $INFO[Window(Home).Property(dv.details.rating_tmdb), ★ ]</label>
          <font>font13</font><textcolor>FF66BB6A</textcolor><aligny>center</aligny>
        </control>
      </control>
      <control type="group">
        <width>120</width><height>36</height>
        <visible>!String.IsEmpty(Window(Home).Property(dv.details.rating_imdb))</visible>
        <control type="label">
          <width>120</width><height>36</height>
          <label>IMDb $INFO[Window(Home).Property(dv.details.rating_imdb)]</label>
          <font>font10</font><textcolor>FFF5C518</textcolor><aligny>center</aligny>
        </control>
      </control>
      <control type="group">
        <width>150</width><height>36</height>
        <visible>!String.IsEmpty(Window(Home).Property(dv.details.rating_metascore))</visible>
        <control type="label">
          <width>150</width><height>36</height>
          <label>Metascore $INFO[Window(Home).Property(dv.details.rating_metascore)]</label>
          <font>font10</font><textcolor>FFB0BEC5</textcolor><aligny>center</aligny>
        </control>
      </control>
      <control type="group">
        <width>190</width><height>36</height>
        <visible>!String.IsEmpty(Window(Home).Property(dv.details.rating_rotten))</visible>
        <control type="label">
          <width>190</width><height>36</height>
          <label>Rotten Tomatoes $INFO[Window(Home).Property(dv.details.rating_rotten)]</label>
          <font>font10</font><textcolor>FFFA320A</textcolor><aligny>center</aligny>
        </control>
      </control>
    </control>

    <control type="label">
      <left>72</left><top>280</top><width>1180</width><height>88</height>
      <label>$INFO[Window(Home).Property(dv.details.plot)]</label>
      <font>font11</font><textcolor>FFE0E4EA</textcolor>
      <wrapmultiline>true</wrapmultiline>
    </control>
    <control type="image">
      <left>72</left><top>450</top><width>400</width><height>6</height>
      <texture>dv_progress_bg_v08.png</texture>
      <visible>!String.IsEmpty(Window(Home).Property(dv.details.has_progress))</visible>
    </control>
    <control type="image">
      <left>72</left><top>450</top><width>$INFO[Window(Home).Property(dv.details.barwidth)]</width><height>6</height>
      <texture>dv_progress_fg_v08.png</texture>
      <visible>!String.IsEmpty(Window(Home).Property(dv.details.has_progress))</visible>
    </control>

    <control type="panel" id="1220">
      <left>1280</left><top>96</top><width>600</width><height>150</height>
      <orientation>horizontal</orientation>
      <scrolltime>120</scrolltime>
      <wraparound>false</wraparound>
      <enable>false</enable>
      <visible>!String.IsEmpty(Window(Home).Property(dv.details.tmdb_id))</visible>
      <content target="videos">plugin://skin.dejavu.poc/?action=details_cast&amp;tmdb_id=$INFO[Window(Home).Property(dv.details.tmdb_id)]&amp;r=$INFO[Window(Home).Property(dv.details.changed)]</content>
      <itemlayout width="100" height="150">
        <control type="image">
          <left>8</left><top>0</top><width>84</width><height>84</height>
          <texture diffuse="dv_avatar_diffuse.png">$INFO[ListItem.Icon]</texture>
          <aspectratio>scale</aspectratio>
        </control>
        <control type="label">
          <left>0</left><top>88</top><width>100</width><height>48</height>
          <label>$INFO[ListItem.Label]</label>
          <font>font10</font><textcolor>FFE3E7EC</textcolor>
          <align>center</align><wrapmultiline>true</wrapmultiline>
        </control>
      </itemlayout>
      <focusedlayout width="100" height="150">
        <control type="image">
          <left>8</left><top>0</top><width>84</width><height>84</height>
          <texture diffuse="dv_avatar_diffuse.png">$INFO[ListItem.Icon]</texture>
          <aspectratio>scale</aspectratio>
        </control>
        <control type="label">
          <left>0</left><top>88</top><width>100</width><height>48</height>
          <label>$INFO[ListItem.Label]</label>
          <font>font10</font><textcolor>FFE3E7EC</textcolor>
          <align>center</align><wrapmultiline>true</wrapmultiline>
        </control>
      </focusedlayout>
    </control>

    <control type="grouplist" id="1210">
      <left>72</left><top>488</top><width>1776</width><height>56</height>
      <orientation>horizontal</orientation>
      <itemgap>8</itemgap>
      <onup>1001</onup>
      <ondown condition="!String.IsEmpty(Window(Home).Property(dv.details.collection_id))">1310</ondown>
      <ondown condition="!String.IsEmpty(Window(Home).Property(dv.details.has_lists))">1320</ondown>
      <ondown>1001</ondown>
      <control type="button" id="1201">
        <width>200</width><height>52</height>
        <label>$VAR[DetailsWatchLabelVar]</label>
        <font>font11</font><align>center</align>
        <texturefocus>dv_button_focus_v08.png</texturefocus>
        <texturenofocus>dv_button_focus_v08.png</texturenofocus>
        <onclick>RunPlugin($INFO[Window(Home).Property(dv.details.play_url)])</onclick>
      </control>
      <control type="button" id="1217">
        <width>200</width><height>52</height>
        <label>Bande-annonce</label>
        <font>font10</font><align>center</align>
        <texturefocus>dv_button_focus_v08.png</texturefocus>
        <texturenofocus>dv_button_v08.png</texturenofocus>
        <visible>!String.IsEmpty(Window(Home).Property(dv.details.trailer))</visible>
        <onclick>PlayMedia($INFO[Window(Home).Property(dv.details.trailer)])</onclick>
      </control>
      <control type="button" id="1211">
        <width>210</width><height>52</height>
        <label>$VAR[DetailsBtnWatchedVar]</label>
        <font>font10</font><align>center</align>
        <texturefocus>dv_button_focus_v08.png</texturefocus>
        <texturenofocus>dv_button_v08.png</texturenofocus>
        <onclick>RunScript(skin.dejavu.poc,dejavu_action,toggle_watched)</onclick>
      </control>
      <control type="button" id="1212">
        <width>220</width><height>52</height>
        <label>$VAR[DetailsBtnWatchlistVar]</label>
        <font>font10</font><align>center</align>
        <texturefocus>dv_button_focus_v08.png</texturefocus>
        <texturenofocus>dv_button_v08.png</texturenofocus>
        <onclick>RunScript(skin.dejavu.poc,dejavu_action,toggle_watchlist)</onclick>
      </control>
      <control type="button" id="1214">
        <width>230</width><height>52</height>
        <label>$VAR[DetailsBtnCollectionVar]</label>
        <font>font10</font><align>center</align>
        <texturefocus>dv_button_focus_v08.png</texturefocus>
        <texturenofocus>dv_button_v08.png</texturenofocus>
        <onclick>RunScript(skin.dejavu.poc,dejavu_action,toggle_collection)</onclick>
      </control>
      <control type="button" id="1213">
        <width>160</width><height>52</height>
        <label>$VAR[DetailsBtnFavoriteVar]</label>
        <font>font10</font><align>center</align>
        <texturefocus>dv_button_focus_v08.png</texturefocus>
        <texturenofocus>dv_button_v08.png</texturenofocus>
        <onclick>RunScript(skin.dejavu.poc,dejavu_action,toggle_favorites)</onclick>
      </control>
      <control type="button" id="1215">
        <width>140</width><height>52</height>
        <label>$VAR[DetailsBtnRateVar]</label>
        <font>font10</font><align>center</align>
        <texturefocus>dv_button_focus_v08.png</texturefocus>
        <texturenofocus>dv_button_v08.png</texturenofocus>
        <onclick>RunScript(skin.dejavu.poc,dejavu_action,rate)</onclick>
      </control>
      <control type="button" id="1216">
        <width>220</width><height>52</height>
        <label>$VAR[DetailsBtnListVar]</label>
        <font>font10</font><align>center</align>
        <texturefocus>dv_button_focus_v08.png</texturefocus>
        <texturenofocus>dv_button_v08.png</texturenofocus>
        <onclick>RunScript(skin.dejavu.poc,dejavu_action,add_to_list)</onclick>
      </control>
    </control>

    <control type="grouplist" id="2000">
      <left>50</left><top>560</top><width>1820</width><height>470</height>
      <orientation>vertical</orientation>
      <itemgap>12</itemgap>
      <scrolltime tween="sine" easing="out">180</scrolltime>
      <include content="DejaVuDetailsRail">
        <param name="group_id" value="2010" />
        <param name="list_id" value="1310" />
        <param name="title" value="Saga$INFO[Window(Home).Property(dv.details.collection_name),  ·  ]" />
        <param name="content" value="plugin://skin.dejavu.poc/?action=details_collection&amp;tmdb_id=$INFO[Window(Home).Property(dv.details.tmdb_id)]&amp;r=$INFO[Window(Home).Property(dv.details.changed)]" />
        <param name="visible" value="!String.IsEmpty(Window(Home).Property(dv.details.collection_id))" />
        <param name="onup" value="1210" />
        <param name="ondown" value="1320" />
      </include>
      <include content="DejaVuDetailsListRail">
        <param name="group_id" value="2020" />
        <param name="list_id" value="1320" />
        <param name="title" value="Dans les listes suivantes" />
        <param name="content" value="plugin://skin.dejavu.poc/?action=details_in_lists&amp;tmdb_id=$INFO[Window(Home).Property(dv.details.tmdb_id)]&amp;r=$INFO[Window(Home).Property(dv.details.changed)]" />
        <param name="visible" value="!String.IsEmpty(Window(Home).Property(dv.details.has_lists))" />
        <param name="onup" value="1310" />
        <param name="ondown" value="1210" />
      </include>
    </control>

    <control type="list" id="50">
      <left>-80</left><top>0</top><width>40</width><height>40</height>
      <content target="videos">plugin://skin.dejavu.poc/?action=details_item&amp;type=movie&amp;tmdb_id=$INFO[Window(Home).Property(dv.details.tmdb_id)]&amp;title=$INFO[Window(Home).Property(dv.details.title)]&amp;r=$INFO[Window(Home).Property(dv.details.changed)]</content>
    </control>
  </controls>
</window>
