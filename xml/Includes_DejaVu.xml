<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<!-- dejaVu functional component primitives.
	     Visual identity is intentionally delegated to Kodi/Estuary for now. -->

	<include name="DejaVuButton">
		<param name="control_id">23001</param>
		<param name="left">0</param>
		<param name="top">0</param>
		<param name="width">500</param>
		<param name="height">75</param>
		<param name="label">dejaVu button</param>
		<param name="onclick">Notification(dejaVu, Button action,3000)</param>
		<definition>
			<include content="DefaultDialogButton">
				<param name="id" value="$PARAM[control_id]" />
				<param name="left" value="$PARAM[left]" />
				<param name="top" value="$PARAM[top]" />
				<param name="width" value="$PARAM[width]" />
				<param name="height" value="$PARAM[height]" />
				<param name="label" value="$PARAM[label]" />
				<param name="onclick" value="$PARAM[onclick]" />
				<param name="onup" value="$PARAM[onup]" />
				<param name="ondown" value="$PARAM[ondown]" />
				<param name="onleft" value="$PARAM[onleft]" />
				<param name="onright" value="$PARAM[onright]" />
			</include>
		</definition>
	</include>

	<include name="DejaVuMediaCard">
		<param name="focused">false</param>
		<param name="width">310</param>
		<param name="height">486</param>
		<definition>
			<control type="group">
				<left>68</left>
				<top>10</top>
				<width>$PARAM[width]</width>
				<height>$PARAM[height]</height>
				<depth>DepthContentPopout</depth>
				<include content="InfoWallMovieLayout">
					<param name="focused" value="$PARAM[focused]" />
				</include>
			</control>
		</definition>
	</include>

	<include name="DejaVuRail">
		<param name="control_id">23100</param>
		<param name="left">0</param>
		<param name="top">0</param>
		<param name="width">1180</param>
		<param name="height">500</param>
		<param name="header">dejaVu Rail</param>
		<param name="content_path">videodb://movies/titles/</param>
		<definition>
			<control type="group">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[width]</width>
				<height>$PARAM[height]</height>
				<include content="CategoryLabel">
					<param name="label" value="$PARAM[header]" />
					<param name="list_id" value="$PARAM[control_id]" />
				</include>
				<control type="panel" id="$PARAM[control_id]">
					<left>0</left>
					<top>115</top>
					<width>$PARAM[width]</width>
					<height>330</height>
					<orientation>horizontal</orientation>
					<focusposition>0</focusposition>
					<include>WidgetListCommon</include>
					<itemlayout width="240" height="330">
						<include content="DejaVuMediaCard">
							<param name="width" value="240" />
							<param name="height" value="330" />
							<param name="focused" value="false" />
						</include>
					</itemlayout>
					<focusedlayout width="240" height="330">
						<include content="DejaVuMediaCard">
							<param name="width" value="240" />
							<param name="height" value="330" />
							<param name="focused" value="true" />
						</include>
					</focusedlayout>
					<content target="videos" browse="never">$PARAM[content_path]</content>
				</control>
			</control>
		</definition>
	</include>
</includes>
