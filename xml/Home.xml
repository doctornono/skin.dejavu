<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<window>
  <defaultcontrol>1001</defaultcontrol>
  <backgroundcolor>FF03070C</backgroundcolor>
  <onload>RunScript(skin.dejavu.poc)</onload>
  <onload>RunScript(skin.dejavu.poc,watch_header)</onload>
  <controls>

    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>colors/black.png</texture>
      <colordiffuse>FF03070C</colordiffuse>
    </control>

    <include content="DejaVuHeader">
      <param name="ondown" value="111" />
    </include>

    <!-- HERO follows the selected rail item (dv.hero.rail) -->
    <control type="image" id="1200">
      <left>0</left><top>64</top><width>1920</width><height>496</height>
      <texture>$VAR[HeroFanartVar]</texture>
      <aspectratio>scale</aspectratio>
    </control>
    <control type="image">
      <left>0</left><top>64</top><width>1920</width><height>496</height>
      <texture>hero_gradient_v08.png</texture><aspectratio>stretch</aspectratio>
    </control>

    <control type="image">
      <left>72</left><top>96</top><width>180</width><height>28</height>
      <texture>dv_chip_v08.png</texture>
      <aspectratio>stretch</aspectratio>
    </control>
    <control type="label">
      <left>72</left><top>96</top><width>180</width><height>28</height>
      <label>$VAR[HeroTypeChipVar]</label><font>font_flag</font><textcolor>FFFFFFFF</textcolor>
      <align>center</align><aligny>center</aligny>
    </control>
    <control type="image">
      <left>1580</left><top>96</top><width>220</width><height>330</height>
      <texture>$VAR[HeroPosterVar]</texture>
      <aspectratio align="center" aligny="center">keep</aspectratio>
      <visible>String.IsEqual(Window.Property(dv.hero.mode),rail) + !String.IsEmpty($VAR[HeroPosterVar])</visible>
    </control>
    <control type="label">
      <left>72</left><top>138</top><width>920</width><height>64</height>
      <label>$VAR[HeroLabelVar]</label>
      <font>font45_title</font><textcolor>FFFFFFFF</textcolor>
      <scroll>true</scroll>
    </control>
    <control type="label">
      <left>72</left><top>202</top><width>900</width><height>28</height>
      <label>$VAR[HeroMetaVar]</label>
      <font>font13</font><textcolor>FFE3E7EC</textcolor>
      <visible>!String.IsEqual(Window.Property(dv.hero.mode),rail)</visible>
    </control>
    <control type="label">
      <left>72</left><top>230</top><width>900</width><height>24</height>
      <label>$VAR[HeroCastVar]</label>
      <font>font11</font><textcolor>FFC5CCD4</textcolor>
      <scroll>true</scroll>
      <visible>!String.IsEqual(Window.Property(dv.hero.mode),rail) + !String.IsEmpty($VAR[HeroCastVar])</visible>
    </control>
    <control type="label">
      <left>72</left><top>254</top><width>900</width><height>24</height>
      <label>$VAR[HeroStatusVar]</label>
      <font>font11</font><textcolor>FFFFD54F</textcolor>
      <visible>!String.IsEqual(Window.Property(dv.hero.mode),rail) + !String.IsEmpty($VAR[HeroStatusVar])</visible>
    </control>
    <control type="label">
      <left>72</left><top>280</top><width>820</width><height>54</height>
      <label>$VAR[HeroPlotVar]</label>
      <font>font11</font><textcolor>FFE0E4EA</textcolor>
      <wrapmultiline>true</wrapmultiline>
    </control>
    <control type="image">
      <left>72</left><top>348</top><width>400</width><height>6</height>
      <texture>dv_progress_bg_v08.png</texture>
      <visible>!String.IsEqual(Window.Property(dv.hero.mode),rail) + Integer.IsGreater($VAR[HeroPercentBarWidthVar],0)</visible>
    </control>
    <control type="image">
      <left>72</left><top>348</top><width>$VAR[HeroPercentBarWidthVar]</width><height>6</height>
      <texture>dv_progress_fg_v08.png</texture>
      <visible>!String.IsEqual(Window.Property(dv.hero.mode),rail) + Integer.IsGreater($VAR[HeroPercentBarWidthVar],0)</visible>
    </control>

