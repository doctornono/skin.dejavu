<?xml version="1.0" encoding="UTF-8"?>
<window>
  <defaultcontrol always="true">1001</defaultcontrol>
  <backgroundcolor>FF101010</backgroundcolor>
  <controls>
    <control type="label">
      <left>80</left><top>80</top><width>1200</width><height>80</height>
      <label>dejaVu</label>
      <font>font45_title</font><textcolor>FFFFFFFF</textcolor>
    </control>
    <control type="label">
      <left>80</left><top>180</top><width>1400</width><height>50</height>
      <label>Socle Kodi 21 — Lot 1</label>
      <font>font20_title</font><textcolor>FFB8B8B8</textcolor>
    </control>
    <control type="button" id="1001">
      <left>80</left><top>300</top><width>520</width><height>72</height>
      <label>Skin dejaVu actif</label>
      <font>font20_title</font><textcolor>FFFFFFFF</textcolor>
      <focusedcolor>FF7B2820</focusedcolor>
      <onleft>1002</onleft><onright>1002</onright><onup>1001</onup><ondown>1001</ondown>
      <onclick>noop</onclick>
    </control>
    <control type="button" id="1002">
      <left>640</left><top>300</top><width>520</width><height>72</height>
      <label>Rafraichir la skin</label>
      <font>font20_title</font><textcolor>FFFFFFFF</textcolor>
      <focusedcolor>FF7B2820</focusedcolor>
      <onleft>1001</onleft><onright>1001</onright><onup>1002</onup><ondown>1003</ondown>
      <onclick>ReloadSkin()</onclick>
    </control>
    <control type="button" id="1003">
      <left>80</left><top>400</top><width>520</width><height>72</height>
      <label>Retourner sur la skin Estuary</label>
      <font>font20_title</font><textcolor>FFFFFFFF</textcolor>
      <focusedcolor>FF7B2820</focusedcolor>
      <onleft>1003</onleft><onright>1003</onright><onup>1002</onup><ondown>1003</ondown>
      <visible>System.HasAddon(script.dejavu)</visible>
      <onclick>RunScript(script.dejavu,action=switch_skin,skin=skin.estuary)</onclick>
    </control>
    <control type="button" id="1004">
      <left>640</left><top>400</top><width>520</width><height>72</height>
      <label>Quitter Kodi</label>
      <font>font20_title</font><textcolor>FFFFFFFF</textcolor>
      <focusedcolor>FF7B2820</focusedcolor>
      <onleft>1003</onleft><onright>1003</onright><onup>1002</onup><ondown>1004</ondown>
      <onclick>Quit()</onclick>
    </control>

    <control type="label">
      <left>80</left><top>520</top><width>1600</width><height>100</height>
      <label>Fondations chargées : addon.xml, Font.xml, Includes.xml et ScreenProfile.</label>
      <font>font13</font><textcolor>FFB8B8B8</textcolor><wrapmultiline>true</wrapmultiline>
    </control>

    <control type="label">
      <left>80</left><top>640</top><width>1600</width><height>50</height>
      <label>$LOCALIZE[14001] : $INFO[System.ScreenWidth] x $INFO[System.ScreenHeight]</label>
      <font>font12</font><textcolor>FFB8B8B8</textcolor>
    </control>

    <control type="label">
      <left>80</left><top>700</top><width>1600</width><height>45</height>
      <label>ScreenProfile — Laptop 6 cols / 7 cartes · Desktop 8 / 9 · Mobile 3 / 3 · TV 6 / 6</label>
      <font>font12</font><textcolor>FFB8B8B8</textcolor>
    </control>

    <control type="label">
      <left>80</left><bottom>70</bottom><width>1600</width><height>40</height>
      <label>Validation Kodi 21 — activation, interaction et ScreenProfile</label>
      <font>font12</font><textcolor>FF7B2820</textcolor>
    </control>
  </controls>
</window>