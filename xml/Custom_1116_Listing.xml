      </control>
      <control type="image">
        <left>860</left><top>240</top><width>100</width><height>100</height>
        <aspectratio>keep</aspectratio>
        <texture>dialogs/extendedprogress/loading.png</texture>
        <animation effect="rotate" center="auto" start="360" end="0" time="1500" loop="true" condition="true">Conditional</animation>
      </control>
    </control>

    <control type="label">
      <left>66</left><top>620</top><width>1400</width><height>40</height>
      <label>Aucun titre dans cette liste</label>
      <font>font13</font>
      <textcolor>FF68717D</textcolor>
      <visible>Integer.IsEqual(Container(1400).NumItems,0) + !Container(1400).IsUpdating</visible>
    </control>
