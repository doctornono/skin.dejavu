      <align>center</align>
      <aligny>center</aligny>
      <texturefocus>dv_button_focus_v08.png</texturefocus>
      <texturenofocus>dv_button_v08.png</texturenofocus>
      <visible>!String.IsEmpty(Window(Home).Property(dv.list.prev))</visible>
      <onclick>RunPlugin(plugin://skin.dejavu.poc/?action=list_prev)</onclick>
      <onleft>1001</onleft>
      <onright>1402</onright>
      <ondown>1400</ondown>
      <onup>1001</onup>
