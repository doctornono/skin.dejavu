      <left>50</left>
      <top>412</top>
      <width>1820</width>
      <height>620</height>
      <orientation>vertical</orientation>
      <preloaditems>2</preloaditems>
      <scrolltime tween="sine" easing="out">180</scrolltime>
      <onup condition="!String.IsEmpty(Window(Home).Property(dv.list.next))">1402</onup>
      <onup condition="!String.IsEmpty(Window(Home).Property(dv.list.prev))">1401</onup>
      <onup>1001</onup>
      <ondown>1400</ondown>
      <onleft>1001</onleft>
      <onclick condition="String.IsEqual(ListItem.Property(IsFolder),true)">RunPlugin(plugin://skin.dejavu.poc/?action=list_open)</onclick>
      <onclick condition="!String.IsEqual(ListItem.Property(IsFolder),true)">RunPlugin(plugin://skin.dejavu.poc/?action=open_details)</onclick>
      <content target="videos">plugin://skin.dejavu.poc/?action=seeall&amp;rev=$INFO[Window(Home).Property(dv.list.rev)]</content>
      <itemlayout width="182" height="310">
        <include content="DejaVuPosterItem">
          <param name="focused" value="false" />
        </include>
      </itemlayout>
      <focusedlayout width="182" height="310">
        <include content="DejaVuPosterItem">
          <param name="focused" value="true" />
        </include>
        <include content="DejaVuCardFocusRing">
          <param name="width" value="176" />
          <param name="height" value="258" />
        </include>
      </focusedlayout>
