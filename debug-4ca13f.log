.."], "rating": 8.3, "votes": 2515, "mpaa": "12", "mediatype": "tvshow"}, "art": {"poster": "https://image.tmdb.org/t/p/w500/4DLOp2jfHtbDUXYoKfAsPIDfeS8.jpg", "fanart": "https://image.tmdb.org/t/p/w1280/j5w04XEuFv85N3RIovXBJIHxjSb.jpg", "thumb": "https://image.tmdb.org/t/p/w342/4DLOp2jfHtbDUXYoKfAsPIDfeS8.jpg"}}, {"type": "tv", "tmdbId": 90228, "addedAt": "2024-12-26T22:51:40.000Z", "priority": 0, "notes": null, "info": {"title": "Dune : Prophecy", "originaltitle": "Dune: Prophecy", "year": 2024, "plot": "10 000 ans avant l'ascension de Paul Atreides, les S\u0153urs Harkonnen combattent des forces qui menacent l'avenir de l'humanit\u00e9 et \u00e9tablissent la secte l\u00e9gendaire connue sous le nom de Bene Gesserit.", "tagline": "Le contr\u00f4le est la cl\u00e9 du pouvoir.", "genre": ["...", "...", "..."], "rating": 7.208, "votes": 642, "mpaa": "16", "mediatype": "tvshow"}, "art": {"poster": "https://image.tmdb.org/t/p/w500/vVhx4SP0eyDOmYRJdUNIQ24fGL5.jpg", "fanart": "https://image.tmdb.org/t/p/w1280/lBoHzOgft2QfpjkVVvZCqeM4ttT.jpg", "thumb": "https://image.tmdb.org/t/p/w342/vVhx4SP0eyDOmYRJdUNIQ24fGL5.jpg"}}, "\u2026+27"]}, "pagination": {"total": 39, "page": 1, "pageSize": 100, "totalPages": 1, "hasMore": false}}, "result_type": "dict", "result_len": 3}, "timestamp": 1789472444418}
