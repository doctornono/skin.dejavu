{"sessionId": "4ca13f", "runId": "post-fix", "hypothesisId": "C", "location": "meta.py:log_dejavu_rpc", "message": "script.dejavu rpc return", "data": {"kind": "NotifyAll", "action": "get_history", "params": {"type": "movie", "page": 1, "page_size": 20, "sort": "watchedAt:desc", "minimal": false, "result_property": "script.dejavu.get_history.result.ce075f092a80"}, "result": {"success": true, "data": {"movies": [{"type": "movie", "tmdbId": 1101383, "imdbId": "tt27165187", "watchedAt": "2026-09-15T06:31:22.167Z", "rewatchCount": 1, "info": {"title": "La Fin d'Oak Street", "originalTitle": "The End of Oak Street", "year": 2026, "plot": "Lorsqu\u2019un myst\u00e9rieux \u00e9v\u00e9nement cosmique arrache Oak Street \u00e0 sa paisible banlieue et la transporte vers un lieu inconnu, la famille Platt, d\u00e9sorient\u00e9e dans ce nouvel environnement hostile, comprend vite qu\u2019il leur faudra rester unis pour survivre.", "tagline": "", "genre": ["...", "...", "..."], "director": ["..."], "cast": ["...", "...", "...", "...", "...", "...", "...", "...", "...", "..."], "studio": ["...", "...", "..."], "country": ["..."], "duration": 6000, "rating": 6.3, "votes": 470, "mpaa": "TP", "premiered": "2026-08-12", "trailer": "https://www.youtube.com/watch?v=t3fQ2lTNtks", "mediatype": "movie"}, "art": {"poster": "https://image.tmdb.org/t/p/w500/1flRy4qysdwjhlqw2BZ1Wm1zcpM.jpg", "fanart": "https://image.tmdb.org/t/p/w1280/b9q9VmbXDvJmTziRqkwdEmFdwhr.jpg", "thumb": "https://image.tmdb.org/t/p/w342/1flRy4qysdwjhlqw2BZ1Wm1zcpM.jpg"}}, {"type": "movie", "tmdbId": 1137844, "imdbId": "tt28014327", "watchedAt": "2026-09-11T21:11:50.727Z", "rewatchCount": 1, "info": {"title": "Mayday", "originalTitle": "Mayday", "year": 2026, "plot": "Un pilote de la Navy envoy\u00e9 en mission secr\u00e8te durant la guerre froide se retrouve pi\u00e9g\u00e9 en territoire ennemi. Son seul espoir de survie est de s'allier \u00e0 un ex-agent du KGB excentrique.", "tagline": "Une amiti\u00e9 avec de gros red