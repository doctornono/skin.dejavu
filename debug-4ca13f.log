{"sessionId": "4ca13f", "runId": "post-fix", "hypothesisId": "C", "location": "meta.py:log_dejavu_rpc", "message": "script.dejavu rpc return", "data": {"kind": "NotifyAll", "action": "get_ratings", "params": {"type": null, "page": 1, "page_size": 20, "minimal": false, "result_property": "script.dejavu.get_ratings.result.cbab587ac05c"}, "result": {"success": true, "data": {"movies": [{"type": "movie", "tmdbId": 1101383, "imdbId": "tt27165187", "rating": 7, "review": null, "createdAt": "2026-09-15T06:31:17.200Z", "info": {"title": "La Fin d'Oak Street", "originalTitle": "The End of Oak Street", "year": 2026, "plot": "Lorsqu\u2019un myst\u00e9rieux \u00e9v\u00e9nement cosmique arrache Oak Street \u00e0 sa paisible banlieue et la transporte vers un lieu inconnu, la famille Platt, d\u00e9sorient\u00e9e dans ce nouvel environnement hostile, comprend vite qu\u2019il leur faudra rester unis pour survivre.", "tagline": "", "genre": ["...", "...", "..."], "director": ["..."], "cast": ["...", "...", "...", "...", "...", "...", "...", "...", "...", "..."], "studio": ["...", "...", "..."], "country": ["..."], "duration": 6000, "rating": 6.3, "votes": 470, "mpaa": "TP", "premiered": "2026-08-12", "trailer": "https://www.youtube.com/watch?v=t3fQ2lTNtks", "mediatype": "movie"}, "art": {"poster": "https://image.tmdb.org/t/p/w500/1flRy4qysdwjhlqw2BZ1Wm1zcpM.jpg", "fanart": "https://image.tmdb.org/t/p/w1280/b9q9VmbXDvJmTziRqkwdEmFdwhr.jpg", "thumb": "https://image.tmdb.org/t/p/w342/1flRy4qysdwjhlqw2BZ1Wm1zcpM.jpg"}}, {"type": "movie", "tmdbId": 1137844, "imdbId": "tt28014327", "rating": 7, "review": null, "createdAt": "2026-09-11T21:11:47.581Z", "info": {"title": "Mayday", "originalTitle": "Mayday", "year": 2026, "plot": "Un pilote de la Navy envoy\u00e9 en mission secr\u00e8te durant la guerre froide se retrouve pi\u00e9g\u00e9 en territoire ennemi. Son seul espoir de survie est de s'allier \u00e0 un ex-agent du KGB excentrique.", "tagline": "Une amiti\u00e9 avec de gros red flags.", "genre": ["...", "..."], "director": ["...", "..."], "cast": ["...", "...", "...", "...", "...", "...", "...", "...", "...", "..."], "studio": ["...", "...", "..."], "country": ["..."], "duration": 6660, "rating": 7.9, "votes": 557, "mpaa": null, "premiered": "2026-09-03", "trailer": "", "mediatype": "movie"}, "art": {"poster": "https://image.tmdb.org/t/p/w500/eHELFF4BBxmEk5JyhV017Xcgvwy.jpg", "fanart": "https://image.tmdb.org/t/p/w1280/g7Ccid5kuD7A8hXWlsQiNfwOxaD.jpg", "thumb": "https://image.tmdb.org/t/p/w342/eHELFF4BBxmEk5JyhV017Xcgvwy.jpg"}}, {"type": "movie", "tmdbId": 13922, "imdbId": "tt0326905", "rating": 7, "review": null, "createdAt": "2026-09-11T13:11:17.396Z", "info": {"title": "Le Grand Raid", "originalTitle": "The Great Raid", "year": 2005, "plot": "En janvier 1945, l'arm\u00e9e japonaise, qui occupe les Philippines, retient prisonniers dans le camp de Cabanatuan plus de 500 soldats am\u00e9ricains. Parmi eux, le major Gibson, malgr\u00e9 la malaria qui le ronge, tente de remonter le moral de ses troupes qui meurent de faim. Gr\u00e2ce \u00e0 Margaret, une veuve de guerre, il arrive \u00e0 faire p\u00e9n\u00e9trer en contrebande des m\u00e9dicaments. Pendant ce temps, le sixi\u00e8me bataillon de Rangers sous le commandement du lieutenant-colonel Henry Mucci, se pr\u00e9pare \u00e0 lancer une op\u00e9rat\u2026", "tagline": "L'op\u00e9ration de sauvetage la plus triomphale de l'histoire", "genre": ["...", "...", "..."], "director": ["..."], "cast": ["...", "...", "...", "...", "...", "...", "...", "...", "...", "..."], "studio": ["...", "..."], "country": ["..."], "duration": 7920, "rating": 6.541, "votes": 393, "mpaa": "16", "premiered": "2005-08-12", "trailer": "https://www.youtube.com/watch?v=tQTngYIp-UY", "mediatype": "movie"}, "art": {"poster": "https://image.tmdb.org/t/p/w500/o6jRijgpSPsmNY6gkyN7HPntwdl.jpg", "fanart": "https://image.tmdb.org/t/p/w1280/6gFB71pIo0PY3OOrojTQ97Qy8qq.jpg", "thumb": "https://image.tmdb.org/t/p/w342/o6jRijgpSPsmNY6gkyN7HPntwdl.jpg"}}, {"type": "movie", "tmdbId": 1151031, "imdbId": "tt32246771", "rating": 7, "review": null, "createdAt": "2026-09-11T13:11:17.300Z", "info": {"title": "Substitution : Bring Her Back", "originalTitle": "Bring Her Back", "year": 2025, "plot": "\u00c0 la mort accidentelle de son p\u00e8re, Andy r\u00e9clame la garde de Piper, sa demi-s\u0153ur malvoyante, mais il lui manque trois mois pour atteindre les 18 ans r\u00e9glementaires. En attendant, les services sociaux placent Piper chez Laura, une conseill\u00e8re habitu\u00e9e de ce genre de cas. Mais le protecteur Andy refuse de se s\u00e9parer de sa demi-s\u0153ur et s'impose chez Laura, qui habite une grande maison \u00e0 la campagne. Tr\u00e8s vite, l'adolescent remarque le comportement \u00e9trange et intrusif de leur h\u00f4tesse, qui h\u00e9berge d\u00e9\u2026", "tagline": "", "genre": ["..."], "director": ["...", "..."], "cast": ["...", "...", "...", "...", "...", "...", "...", "...", "...", "..."], "studio": ["...", "...", "..."], "country": ["...", "..."], "duration": 6240, "rating": 7.336, "votes": 1916, "mpaa": "16", "premiered": "2025-05-19", "trailer": "https://www.youtube.com/watch?v=cyGyW15M0hI", "mediatype": "movie"}, "art": {"poster": "https://image.tmdb.org/t/p/w500/AjBNmvAUbl8RMMYmv1dFfP9I1II.jpg", "fanart": "https://image.tmdb.org/t/p/w1280/2IIKts2A9vnUdM9tTC76B8tDmuZ.jpg", "thumb": "https://image.tmdb.org/t/p/w342/AjBNmvAUbl8RMMYmv1dFfP9I1II.jpg"}}, {"type": "movie", "tmdbId": 392142, "imdbId": "tt5091538", "rating": 7, "review": null, "createdAt": "2026-08-22T22:19:16.815Z", "info": {"title": "La Folle Histoire de Max et L\u00e9on", "originalTitle": "La Folle Histoire de Max et L\u00e9on", "year": 2016, "plot": "1939. Max et L\u00e9on, 25 ans, deux amis ins\u00e9parables, totalement immatures et incons\u00e9quents, d\u00e9sertent leur bataillon dans le seul but de regagner M\u00e2con, retrouver leur petite vie tranquille et boire du Chablis. Mais plus ils cherchent \u00e0 fuir, plus leur petite histoire se retrouve li\u00e9e \u00e0 la grande... au point d'aider au d\u00e9barquement sur les plages de Normandie !", "tagline": "", "genre": ["...", "...", "..."], "director": ["..."], "cast": ["...", "...", "...", "...", "...", "...", "...", "...", "...", "..."], "studio": ["...", "...", "..."], "country": ["...", "..."], "duration": 5880, "rating": 6.309, "votes": 841, "mpaa": null, "premiered": "2016-11-01", "trailer": "https://www.youtube.com/watch?v=rDWeALr9g3o", "mediatype": "movie"}, "art": {"poster": "https://image.tmdb.org/t/p/w500/47qB83tIFr9CuX6RHsTapk0W3Ls.jpg", "fanart": "https://image.tmdb.org/t/p/w1280/lNlWxQFrAnbDzOSrXONxII4gKNp.jpg", "thumb": "https://image.tmdb.org/t/p/w342/47qB83tIFr9CuX6RHsTapk0W3Ls.jpg"}}], "totalMovies": 2639, "tvShows": [{"type": "tv", "tmdbId": 83981, "rating": 7, "review": null, "createdAt": "2026-06-02T22:04:21.415Z", "info": {"title": "La Guerre des mondes", "originaltitle": "The War of the Worlds", "year": 2019, "plot": "Dans l'Angleterre des ann\u00e9es 1900, un couple ne cesse de d\u00e9fier les conventions sociales, jusqu'au jour o\u00f9 une invasion extraterrestre les oblige \u00e0 se battre pour leur vie.", "tagline": "", "genre": ["...", "..."], "rating": 6.7, "votes": 299, "mpaa": null, "mediatype": "tvshow"}, "art": {"poster": "https://image.tmdb.org/t/p/w500/1vaBi9eax4Xt6KToGxW3DKeuvHU.jpg", "fanart": "https://image.tmdb.org/t/p/w1280/xLh6Lkj0J5d4new50BxDHEB7wjj.jpg", "thumb": "https://image.tmdb.org/t/p/w342/1vaBi9eax4Xt6KToGxW3DKeuvHU.jpg"}}, {"type": "tv", "tmdbId": 15571, "rating": 7, "review": null, "createdAt": "2026-06-02T22:04:14.267Z", "info": {"title": "Holocauste", "originaltitle": "Holocaust", "year": 1978, "plot": "Berlin, Allemagne, 1935. Le jour o\u00f9 Karl Weiss, un peintre juif, et Inga Helms, une chr\u00e9tienne, se marient, tous deux et toute la famille Weiss sont pris dans le maelstr\u00f6m du r\u00e9gime nazi, les temp\u00eates de la Seconde Guerre mondiale et les horreurs de