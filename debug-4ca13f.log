{"sessionId": "4ca13f", "runId": "post-fix", "hypothesisId": "C", "location": "meta.py:log_dejavu_rpc", "message": "script.dejavu rpc return", "data": {"kind": "NotifyAll", "action": "get_list_items", "params": {"list_id": "cmnk4ji1q004n04kywpnvb3lu", "page": 1, "page_size": 100, "minimal": false, "result_property": "script.dejavu.get_list_items.result.46a68a4be875"}, "result": {"success": true, "data": [{"type": "movie", "tmdbId": 3114, "imdbId": "tt0049730", "position": 1000, "notes": null, "info": {"title": "La Prisonni\u00e8re du d\u00e9sert", "originalTitle": "The Searchers", "year": 1956, "plot": "Texas 1868. La famille d'Aaron Edwards est d\u00e9cim\u00e9e par une bande de comanches qui attaquent son ranch et enl\u00e8vent ses deux fillettes. Ethan, le fr\u00e8re d'Aaron, d\u00e9couvre le drame et se lance sur les traces des ravisseurs avec deux autres compagnons.", "tagline": "Il fallait qu'il la trouve\u2026 il fallait qu'il la trouve\u2026", "genre": ["Western"], "director": ["John Ford"], "cast": [{"name": "...", "role": "...", "thumbnail": "..."}, {"name": "...", "role": "...", "thumbnail": "..."}, {"name": "...", "role": "...", "thumbnail": "..."}, {"name": "...", "role": "...", "thumbnail": "..."}, {"name": "...", "role": "...", "thumbnail": "..."}, {"name": "...", "role": "...", "thumbnail": "..."}, {"name": "...", "role": "...", "thumbnail": "..."}, {"name": "...", "role": "...", "thumbnail": "..."}, {"name": "...", "role": "...", "thumbnail": "..."}, {"name": "...", "role": "...", "thumbnail": "..."}], "studio": ["Warner Bros. Pictures", "C.V. Whitney Pictures"], "country": ["US"], "duration": 7140, "rating": 7.694, "votes": 1554, "mpaa": "TP", "premiered": "1956-05-16", "trailer": "https://www.youtube.com/watch?v=5URuwdaQ568", "mediatype": "movie"}, "art": {"poster": "https://image.tmdb.org/t/p/w500/efMX0Nn7dTH7YtExNx6Cjq5cCrs.jpg", "fanart": "https://image.tmdb.org/t/p/w1280/fik1HN9kxpD4CtEOXA4WUruwsg1.jpg", "thumb": "https://image.tmdb.org/t/p/w3