/p/w1280/2lFfjPdVXleGHukp0Phr5pNJ4ab.jpg", "thumb": "https://image.tmdb.org/t/p/w342/m65RC0QMvLSpPYqm7p85g3ewGUJ.jpg"}}, {"type": "tv", "tmdbId": 9126, "addedAt": "2026-03-31T11:32:23.899Z", "priority": 0, "notes": null, "info": {"title": "La 3\u00e8me guerre mondiale", "originaltitle": "World War III", "year": 1982, "plot": "Une troupe de l'arm\u00e9e russe entre clandestinement en Alaska avec pour mission de saboter un pipeline de p\u00e9trole en repr\u00e9sailles de l'embargo am\u00e9ricain sur les c\u00e9r\u00e9ales.", "tagline": "", "genre": ["..."], "rating": 6.2, "votes": 14, "mpaa": null, "mediatype": "tvshow"}, "art": {"poster": "https://image.tmdb.org/t/p/w500/ijDqGdr5FNsy3DaWQTtN83fXN7x.jpg", "fanart": "https://image.tmdb.org/t/p/w1280/8Y5Alw5Rgnt0uCK0s0GqTO05zPA.jpg", "thumb": "https://image.tmdb.org/t/p/w342/ijDqGdr5FNsy3DaWQTtN83fXN7x.jpg"}}, {"type": "tv", "tmdbId": 16118, "addedAt": "2026-03-31T11:32:23.727Z", "priority": 0, "notes": null, "info": {"title": "Les Vampires de Salem", "originaltitle": "Salem's Lot", "year": 1979, "plot": "Bienvenue \u00e0 Salem, si vous croyez que les vampires n'existent plus, vous risquez d'\u00eatre surpris. De sombres \u00e9v\u00e9nements r\u00e9unissent un \u00e9crivain fascin\u00e9 par une \u00e9trange b\u00e2tisse situ\u00e9e au sommet d'une colline, un antiquaire affable entour\u00e9 d'un bric-\u00e0-brac d\u00e9tonnant, et enfin son cadav\u00e9rique assistant. P\u00e9n\u00e9trez un univers o\u00f9 les vivants ont beaucoup de mal \u00e0 le rester et o\u00f9 il est commun de se retrouver p\u00e9trifi\u00e9 de peur.", "tagline": "L'ultime en horreur !", "genre": ["..."], "rating": 6.8, "votes": 524, "mpaa": "12", "mediatype": "tvshow"}, "art": {"poster": "https://image.tmdb.org/t/p/w500/nqPXxgYHjsRS6a9xiFRpmh3wfZU.jpg", "fanart": "https://image.tmdb.org/t/p/w1280/jmQLlm9OMQKoQUmyMZoszaiqp9q.jpg", "thumb": "https://image.tmdb.org/t/p/w342/nqPXxgYHjsRS6a9xiFRpmh3wfZU.jpg"}}, {"type": "tv", "tmdbId": 32763, "addedAt": "2026-03-31T11:32:23.720Z", "priority": 0, "notes": null, "info": {"title": "The Deep : Voyage au fond des mers", "originaltitle": "The Deep", "year": 2010, "plot": "Le sous-marin Orpheus est en mission pour trouver de nouvelles ressources \u00e9nerg\u00e9tiques dans la zone d\u2019extraction du r\u00e9cif de Lomonosov. L\u2019\u00e9quipe de scientifiques \u00e0 bord suit les traces d\u2019une pr\u00e9c\u00e9dente exp\u00e9dition qui s\u2019\u00e9tait achev\u00e9e par un d\u00e9sastre. L\u2019Orpheus est alors attaqu\u00e9 par une force myst\u00e9rieuse, subira-t-il le m\u00eame sort ?", "tagline": "", "genre": ["...", "..."], "rating": 5.9, "votes": 30, "mpaa": "10", "mediatype": "tvshow"}, "art": {"poster": "https://image.tmdb.org/t/p/w500/6xFhx63ec8WPvL5BaXu15IOinoE.jpg", "fanart": "https://image.tmdb.org/t/p/w1280/smjEnqihzpUpLrcT3BNJkXBxU8V.jpg", "thumb": "https://image.tmdb.org/t/p/w342/6xFhx63ec8WPvL5BaXu15IOinoE.jpg"}}, {"type": "tv", "tmdbId": 31756, "addedAt": "2026-03-31T11:32:22.599Z", "priority": 0, "notes": null, "info": {"title": "Op\u00e9ration chaos", "originaltitle": "Impact", "year": 2009, "plot": "Apr\u00e8s une pluie de m\u00e9t\u00e9orites, les anomalies se multiplient sur Terre. L'astrophysicien Alex Kinter et une astronome d\u00e9couvrent que la lune a \u00e9t\u00e9 d\u00e9log\u00e9e de son orbite et s'appr\u00eate \u00e0 entrer en collision avec la Terre...", "tagline": "", "genre": ["...", "...", "..."], "rating": 5.9, "votes": 88, "mpaa": "12", "mediatype": "tvshow"}, "art": {"poster": "https://image.tmdb.org/t/p/w500/tW93Zpgin2YllmhnwjXnh5EeGAy.jpg", "fanart": "https://image.tmdb.org/t/p/w1280/qfR4wMsqkBUu4LLtiQvtqAgL7zQ.jpg", "thumb": "https://image.tmdb.org/t/p/w342/tW93Zpgin2YllmhnwjXnh5EeGAy.jpg"}}, {"type": "tv", "tmdbId": 14141, "addedAt": "2026-03-31T11:32:22.245Z", "priority": 0, "notes": null, "info": {"title": "V : Les Visiteurs", "originaltitle": "V", "year": 1983, "plot": "Les Visiteurs arrivent sur Terre avec des intentions qu'ils promettent bienveillantes. Mais l'illusion ne dure qu'un temps ! Bien vite, les \u00e9v\u00e9nements d\u00e9g\u00e9n\u00e8rent. L'apparence humaine de ces extraterrestres n'est qu'un leurre et leurs intentions sont loin d'\u00eatre pacifiques. Face \u00e0 cette invasion, la r\u00e9sistance s'organise parmi les humains...", "tagline": "Le dernier combat de l'humanit\u00e9", "genre": ["...", "...", "..."], "rating": 7.741, "votes": 966, "mpaa": "10", "mediatype": "tvshow"}, "art": {"poster": "https://image.tmdb.org/t/p/w500/cuV1HfAGnhFiIt0GiSoZ9LBoTXb.jpg", "fanart": "https://image.tmdb.org/t/p/w1280/wkE9IUAKemdWGWOad3D0jTi0LVi.jpg", "thumb": "https://image.tmdb.org/t/p/w342/cuV1HfAGnhFiIt0GiSoZ9LBoTXb.jpg"}}, {"type": "tv", "tmdbId": 130523, "addedAt": "2026-03-31T11:32:22.245Z", "priority": 0, "notes": null, "info": {"title": "Braqueurs : La s\u00e9rie", "originaltitle": "Braqueurs : La s\u00e9rie", "year": 2021, "plot": "Quand sa ni\u00e8ce contrarie un puissant baron de la drogue, Mehdi et sa bande de pros du braquage se retrouvent au c\u0153ur d'une guerre des gangs violente. Tr\u00e8s violente.", "tagline": "", "genre": ["...", "..."], "rating": 7.135, "votes": 200, "mpaa": "12", "mediatype": "tvshow"}, "art": {"poster": "https://image.tmdb.org/t/p/w500/sxwMPWL627OnIBCBlKyMhER7DCO.jpg", "fanart": "https://image.tmdb.org/t/p/w1280/8sdFdIdShfQboyyMNAMxnHGWEEe.jpg", "thumb": "https://image.tmdb.org/t/p/w342/sxwMPWL627OnIBCBlKyMhER7DCO.jpg"}}, {"type": "tv", "tmdbId": 456, "addedAt": "2026-03-31T09:51:28.636Z", "priority": 0, "notes": null, "info": {"title": "Les Simpson", "originaltitle": "The Simpsons", "year": 1989, "plot": "Situ\u00e9e \u00e0 Springfield, ville am\u00e9ricaine moyenne, la s\u00e9rie se concentre sur les singeries et les aventures quotidiennes de la famille Simpson : Homer, Marge, Bart, Lisa et Maggie, ainsi que des milliers d'autres personnages.", "tagline": "\u00c0 vos marques, pr\u00eats, T'Oh! !", "genre": ["...", "..."], "rating": 8.022, "votes": 10984, "mpaa": "12", "mediatype": "tvshow"}, "art": {"poster": "https://image.tmdb.org/t/p/w500/py1CAYqgpKKtLBdtctLIXfDYDjW.jpg", "fanart": "https://image.tmdb.org/t/p/w1280/jIArNHIekrCSVgdMbKPAXpPY03Y.jpg", "thumb": "https://image.tmdb.org/t/p/w342/py1CAYqgpKKtLBdtctLIXfDYDjW.jpg"}}, {"type": "tv", "tmdbId": 1396, "addedAt": "2026-03-23T13:39:32.250Z", "priority": 0, "notes": null, "info": {"title": "Breaking Bad", "originaltitle": "Breaking Bad", "year": 2008, "plot": "Un professeur de chimie atteint d'un cancer s'associe \u00e0 un ancien \u00e9l\u00e8ve pour fabriquer et vendre de la m\u00e9thamph\u00e9tamine afin d'assurer l'avenir financier de sa famille.", "tagline": "Souviens-toi de mon nom.", "genre": ["...", "..."], "rating": 8.94, "votes": 17409, "mpaa": "16", "mediatype": "tvshow"}, "art": {"poster": "https://image.tmdb.org/t/p/w500/hVVxgGZFR3JaXmkstnG1IR9Qbt6.jpg", "fanart": "https://image.tmdb.org/t/p/w1280/tsRy63Mu5cu8etL1X7ZLyf7UP1M.jpg", "thumb": "https://image.tmdb.org/t/p/w342/hVVxgGZFR3JaXmkstnG1IR9Qbt6.jpg"}}, {"type": "tv", "tmdbId": 1920, "addedAt": "2026-03-18T21:44:50.256Z", "priority": 0, "notes": null, "info": {"title": "Twin Peaks", "originaltitle": "Twin Peaks", "year": 1990, "plot": "Un meurtre a \u00e9t\u00e9 commis \u00e0 Twin Peaks, une petite bourgade de l'\u00c9tat de Washington en apparence tranquille. La jeune Laura Palmer est retrouv\u00e9e morte nue au bord d'un lac, envelopp\u00e9e dans du plastique. L'agent sp\u00e9cial du FBI, Dale Cooper, envoy\u00e9 sur place pour d\u00e9masquer le coupable, m\u00e8ne l'enqu\u00eate avec le soutien du sh\u00e9rif local, Harry Truman. Ces investigations les am\u00e8nent \u00e0 r\u00e9v\u00e9ler au grand jour les sombres secrets des uns et des autres. Pendant ce temps, d'inqui\u00e9tants ph\u00e9nom\u00e8nes se produisent.\u2026", "tagline": "Une ville o\u00f9 tout le monde conna\u00eet tout le monde et o\u00f9 rien n\u2019est ce qu\u2019il semble \u00eatre.", "genre": ["...", "..."], "rating": 8.3, "votes": 2515, "mpaa": "12", "mediatype": "tvshow"}, "art": {"poster": "https://image.tmdb.org/t/p/w500/4DLOp2jfHtbDUXYoKfAsPIDfeS8.jpg", "fanart": "https://image.tmdb.org/t/p/w1280/j5w04XEuFv85N3RIovXBJIHxjSb.jpg", "thumb": "https://image.tmdb.org/t/p/w342/4DLOp2jfHtbDUXYoKfAsPIDfeS8.jpg"}}, {"type": "tv", "tmdbId": 90228, "addedAt": "2024-12-26T22:51:40.000Z", "priority": 0, "notes": null, "info": {"title": "Dune : Prophecy", "originaltitle": "Dune: Prophecy", "year": 2024, "plot": "10 000 ans avant l'ascension de Paul Atreides, les S\u0153urs Harkonnen combattent des forces qui menacent l'avenir de l'humanit\u00e9 et \u00e9tablissent la secte l\u00e9gendaire connue sous le nom de Bene Gesserit.", "tagline": "Le contr\u00f4le est la cl\u00e9 du pouvoir.", "genre": ["...", "...", "..."], "rating": 7.208, "votes": 642, "mpaa": "16", "mediatype": "tvshow"}, "art": {"poster": "https://image.tmdb.org/t/p/w500/vVhx4SP0eyDOmYRJdUNIQ24fGL5.jpg", "fanart": "https://image.tmdb.org/t/p/w1280/lBoHzOgft2QfpjkVVvZCqeM4ttT.jpg", "thumb": "https://image.tmdb.org/t/p/w342/vVhx4SP0eyDOmYRJdUNIQ24fGL5.jpg"}}, "\u2026+27"]}, "pagination": {"total": 39, "page": 1, "pageSize": 100, "totalPages": 1, "hasMore": false}}, "result_type": "dict", "result_len": 3}, "timestamp": 1789472596063}
