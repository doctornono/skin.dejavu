{
    "name": "alkoFlix - Options",
    "plugin": "plugin.video.alkoflix",
    "priority": 202,
    "is_resolvable": "true",
    "play_movie": "executebuiltin://RunPlugin(plugin://plugin.video.alkoflix/?mode=tmdbh_options&media_type=movie&query={name}&year={year}&poster={poster}&title={title}&tmdb_id={id}&autoplay=False)",
    "play_episode": "executebuiltin://RunPlugin(plugin://plugin.video.alkoflix/?mode=tmdbh_options&media_type=episode&query={showname}&year={year}&season={season}&episode={episode}&ep_name={title}&tmdb_id={tmdb}&premiered={firstaired}&autoplay=False&ep_tmdb_id={eptmdb}&ep_imdb_id={epimdb}&ep_tvdb_id={eptvdb})"
}
