<?xml version="1.0" encoding="UTF-8"?>
<addon id="skin.dejavu" version="0.1.1" name="dejaVu" provider-name="dejaVu">
  <requires>
    <import addon="xbmc.gui" version="5.17.0" />
    <import addon="script.dejavu" version="1.0.0" optional="true" />
    <import addon="plugin.video.themoviedb.helper" version="6.0.0" optional="true" />
  </requires>
  <extension point="xbmc.gui.skin" debugging="false">
    <res width="1920" height="1080" aspect="16:9" default="true" folder="xml" />
  </extension>
  <extension point="xbmc.addon.metadata">
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
    <source>https://github.com/doctornono/skin.dejavu</source>
    <summary lang="en_GB">dejaVu skin for Kodi 21.</summary>
    <summary lang="fr_FR">Skin dejaVu pour Kodi 21.</summary>
    <description lang="en_GB">A content-first Kodi skin built around the dejaVu experience.</description>
    <description lang="fr_FR">Un skin Kodi centré sur le contenu et construit autour de l'expérience dejaVu.</description>
    <assets>
      <icon>resources/icon.png</icon>
      <fanart>resources/fanart.jpg</fanart>
    </assets>
  </extension>
</addon>